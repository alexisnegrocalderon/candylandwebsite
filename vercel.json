{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && node scripts/generate-pwa-html.mjs && npx tsx scripts/generate-static-pages.ts && pnpm run build:api",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "**/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin(/.*)?",
      "destination": "/admin.html"
    },
    {
      "source": "/caja(/.*)?",
      "destination": "/caja.html"
    },
    {
      "source": "/puerta(/.*)?",
      "destination": "/puerta.html"
    },
    {
      "source": "/gastos(/.*)?",
      "destination": "/gastos.html"
    },
    {
      "source": "/fiesta(/.*)?",
      "destination": "/fiesta.html"
    },
    {
      "source": "/(cocina|guardarropia|checkout|pago)(/.*)?",
      "destination": "/index.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros.html"
    },
    {
      "source": "/panoramas",
      "destination": "/panoramas.html"
    },
    {
      "source": "/panoramas/vina-del-mar",
      "destination": "/panoramas/vina-del-mar.html"
    },
    {
      "source": "/panoramas/valparaiso",
      "destination": "/panoramas/valparaiso.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/que-son-las-fiestas-liberales",
      "destination": "/blog/que-son-las-fiestas-liberales.html"
    },
    {
      "source": "/blog/tarjeta-playcard",
      "destination": "/blog/tarjeta-playcard.html"
    },
    {
      "source": "/blog/primera-vez-que-esperar",
      "destination": "/blog/primera-vez-que-esperar.html"
    },
    {
      "source": "/blog/dress-code-explicado",
      "destination": "/blog/dress-code-explicado.html"
    },
    {
      "source": "/blog/que-llevar",
      "destination": "/blog/que-llevar.html"
    },
    {
      "source": "/blog/como-llegar-y-estacionar",
      "destination": "/blog/como-llegar-y-estacionar.html"
    },
    {
      "source": "/politica-de-reembolso",
      "destination": "/politica-de-reembolso.html"
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "/politica-de-privacidad.html"
    },
    {
      "source": "/((?!assets/|candyland/|api/|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.ico|gastos\\.webmanifest|gastos/sw\\.js|puerta\\.webmanifest|puerta/sw\\.js|admin\\.webmanifest|admin/sw\\.js|fiesta\\.webmanifest|fiesta/sw\\.js|products/|collections/|cart|account/|pages/|blogs/|apps/|policies/|cdn/).*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/candyland/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/mailing-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/tanda",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/checkin-summary",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/founders-promo",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/admin-digest",
      "schedule": "0 11 * * *"
    }
  ]
}
